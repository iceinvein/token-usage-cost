{
  "name": "claude-cost",
  "version": "0.1.0",
  "description": "Local AI coding usage and estimated cost tracker for Claude, Codex, and Cursor",
  "type": "module",
  "bin": {
    "claude-cost": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iceinvein/token-usage-cost.git"
  },
  "homepage": "https://github.com/iceinvein/token-usage-cost#readme",
  "bugs": {
    "url": "https://github.com/iceinvein/token-usage-cost/issues"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "sync": "bun run src/cli.ts sync",
    "today": "bun run src/cli.ts today",
    "week": "bun run src/cli.ts week",
    "month": "bun run src/cli.ts month",
    "projects": "bun run src/cli.ts projects",
    "models": "bun run src/cli.ts models",
    "daily": "bun run src/cli.ts daily",
    "dashboard": "bun run src/cli.ts dashboard",
    "dashboard:plain": "bun run src/cli.ts dashboard --plain",
    "export": "bun run src/cli.ts export",
    "loki:test": "bun run src/cli.ts loki-test",
    "loki:push": "bun run src/cli.ts loki-push",
    "loki:delete": "bun run src/cli.ts loki-delete",
    "loki:reset": "bun run src/cli.ts loki-reset-sync",
    "check": "tsc --noEmit",
    "build:darwin-arm64": "bun build src/cli.ts --compile --target=bun-darwin-arm64 --outfile dist/claude-cost-darwin-arm64",
    "build:darwin-x64": "bun build src/cli.ts --compile --target=bun-darwin-x64 --outfile dist/claude-cost-darwin-x64",
    "build:linux-x64": "bun build src/cli.ts --compile --target=bun-linux-x64 --outfile dist/claude-cost-linux-x64",
    "build:linux-arm64": "bun build src/cli.ts --compile --target=bun-linux-arm64 --outfile dist/claude-cost-linux-arm64",
    "build:windows-x64": "bun build src/cli.ts --compile --target=bun-windows-x64 --outfile dist/claude-cost-windows-x64.exe",
    "build:all": "bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:windows-x64",
    "release": "bun run scripts/release.ts",
    "prepublishOnly": "bun run check"
  },
  "keywords": [
    "bun",
    "cli",
    "tokens",
    "cost-tracking",
    "claude",
    "codex",
    "cursor",
    "ai-usage"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.1",
    "ink": "^7.0.0",
    "react": "^19.2.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^6.0.2",
    "ws": "^8.20.0"
  }
}
